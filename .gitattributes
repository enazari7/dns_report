# Normalise to LF in the repository.
* text=auto eol=lf

# These are executed on a Linux server. A CRLF checkout on Windows followed by
# an upload would break the shebang line, so pin them regardless of the
# checkout platform.
*.sh            text eol=lf
*.service       text eol=lf
*.ini           text eol=lf
*.py            text eol=lf
*.js            text eol=lf
*.mjs           text eol=lf
*.css           text eol=lf
*.html          text eol=lf
*.yml           text eol=lf
*.webmanifest   text eol=lf
Makefile        text eol=lf

*.svg           text eol=lf
*.png           binary
*.db            binary
*.tgz           binary
*.zip           binary

# Keep generated and vendored files out of the diff view and the language stats.
install.py          linguist-generated=true
docs/*.md           linguist-documentation=true
